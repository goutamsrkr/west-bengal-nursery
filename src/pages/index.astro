---
import '../styles/global.css';
import { business, enquiry } from '../data/business';
const base = import.meta.env.BASE_URL;
const photo = (id: string, w = 800) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=85`;
const hero = 'photo-1624616802149-002faf014f83';
const categories = [
 { name: 'Indoor plants', note: 'A little green for your everyday spaces.', img: 'photo-1592150621744-aca64f48394a', alt: 'Collection of leafy indoor plants', tag: 'For your home' },
 { name: 'Flowering plants', note: 'Colour that makes an ordinary day brighter.', img: 'photo-1567990989224-6441e1483ac8', alt: 'Hibiscus flower in bloom', tag: 'For a little colour' },
 { name: 'Fruit saplings', note: 'Start small. Grow something to look forward to.', img: 'photo-1575574202227-6b68bd6e3f29', alt: 'Established lemon trees, illustrating fruit gardening', tag: 'For your garden' },
 { name: 'Balcony plants', note: 'Make room for nature, even in a small space.', img: 'photo-1574225156227-c41878c02ac5', alt: 'Plants arranged on a balcony', tag: 'For city living' },
 { name: 'Herbs & medicinal plants', note: 'Fragrant leaves for a greener kitchen garden.', img: 'photo-1584528722312-9edb8bb6ec84', alt: 'Green herbs growing in clay pots', tag: 'For everyday rituals' },
 { name: 'Pots & soil', note: 'A good home for every new beginning.', img: 'photo-1584528722312-9edb8bb6ec84', alt: 'A selection of terracotta pots with plants', tag: 'For growing well' }
];
const tips = [ ['01', 'Follow the light.', 'Watch your space through the day. Choose a plant for the light you actually have, and introduce stronger sun gradually.'], ['02', 'Feel the soil first.', 'Rain, humidity and cooler days change how fast pots dry. Check the soil before watering instead of following a fixed calendar.'], ['03', 'Let the roots breathe.', 'Use pots with drainage holes. Empty standing water from saucers and keep drainage outlets clear after rain.'] ];
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>{business.name} · Plant Nursery in West Bengal</title>
 <meta name="description" content="Explore indoor plants, flowering favourites, fruit saplings and garden essentials. A Bengal-inspired nursery website preview with practical plant-care guidance." />
 {business.preview && <meta name="robots" content="noindex, nofollow" />}
 <link rel="canonical" href={new URL(base, Astro.site)} />
 <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
 <link rel="preconnect" href="https://images.unsplash.com" />
 <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
 <meta property="og:title" content={`${business.name} · A little closer to nature`} /><meta property="og:description" content="Plants for rooms, balconies and gardens across West Bengal. Explore the nursery website preview." /><meta property="og:type" content="website" /><meta property="og:url" content={new URL(base, Astro.site)} />
</head>
<body>
 <a class="skip" href="#main">Skip to content</a>
 <div class="utility">Rooted in Bengal. Made for your little corner of green. <span>{business.preview ? 'WEBSITE PREVIEW · BUSINESS DETAILS PENDING' : 'GROW WITH US'}</span></div>
 <header id="header"><a class="brand" href="#" aria-label={`${business.name} home`}><img src={`${base}favicon.svg`} width="42" height="42" alt="" /><span>Bengal Garden<small>N U R S E R Y</small></span></a><nav aria-label="Main navigation"><a href="#plants">Our plants</a><a href="#why-us">Why us</a><a href="#delivery">Delivery</a><a href="#care">Plant care</a></nav><a class="button small header-cta" href={enquiry()}>Let’s talk plants</a><button class="menu" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation">☰</button><nav id="mobile-nav" aria-label="Mobile navigation" hidden><a href="#plants">Our plants</a><a href="#why-us">Why us</a><a href="#delivery">Delivery</a><a href="#care">Plant care</a><a href="#contact">Contact</a></nav></header>
 <main id="main">
 <section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy"><p class="eyebrow"><span class="line"></span> A LITTLE CLOSER TO NATURE</p><h1 id="hero-title">Healthy plants.<br />Happier <em>homes.</em></h1><p class="hero-description">Bring a little of Bengal’s greenery home. Explore plants for sunny balconies, cosy corners, and gardens full of possibility.</p><div class="actions"><a class="button" href={enquiry()}>Enquire on WhatsApp</a><a class="text-link" href="#plants">Explore our plants</a></div><div class="hero-foot"><span class="mini-mark">✳</span><p>A greener space starts with the right plant.<br /><strong>Let’s find yours.</strong></p></div></div>
  <div class="hero-visual"><div class="photo-frame"><img src={photo(hero,1400)} srcset={`${photo(hero,700)} 700w, ${photo(hero,1400)} 1400w`} sizes="(max-width: 760px) 100vw, 50vw" width="700" height="800" fetchpriority="high" alt="Sunlit greenhouse filled with lush green plants; inspiration photograph" /></div><span class="vertical-label">A SLOWER MOMENT. A GREENER HOME.</span><div class="plant-label"><span class="sun">☀</span><div><small>A LITTLE GREEN GOES A LONG WAY</small><strong>Good things take root.</strong></div></div><div class="round-stamp" aria-hidden="true">GROW A LITTLE<br /><span>✳</span><br />EVERY DAY</div></div>
 </section>
 <div class="benefit-strip"><div class="wrap"><span>01 <strong>Plants for every space</strong></span><span>02 <strong>Practical care guidance</strong></span><span>03 <strong>Explore before you enquire</strong></span><span>04 <strong>Inspired by Bengal</strong></span></div></div>
 <section id="plants" class="section wrap" tabindex="-1"><div class="section-heading reveal"><div><p class="eyebrow">FIND YOUR KIND OF GREEN</p><h2>A plant for every<br /><em>little corner.</em></h2></div><p>From your first windowsill plant to a garden you’ve always imagined. Start with a collection that feels like you.</p></div><div class="category-grid">{categories.map((c,i) => <article class="category reveal" style={`--delay:${i%3*80}ms`}><a href={enquiry(c.name)} aria-label={`Ask about ${c.name}`}><div class="category-photo"><img src={photo(c.img)} width="800" height="600" loading="lazy" alt={c.alt} /><span>{c.tag}</span></div><div class="card-heading"><h3>{c.name}</h3><span class="plus" aria-hidden="true">+</span></div><p>{c.note}</p><span class="category-action">Ask about this collection</span></a></article>)}</div><p class="caption">Collection inspiration · photographs illustrate plant types and are not evidence of nursery stock.</p></section>
 <section class="season"><div class="wrap season-inner"><div class="season-photo reveal"><img src={photo('photo-1567990989224-6441e1483ac8',1000)} width="1000" height="1100" loading="lazy" alt="Close-up of a hibiscus flower" /><span class="photo-note">A perennial favourite</span></div><div class="season-copy reveal"><p class="eyebrow">A MOMENT IN THE GARDEN</p><h2>A little colour.<br />A lot of <em>joy.</em></h2><p>Some plants make you stop and look. Hibiscus brings that feeling to a bright balcony or a sunny garden.</p><div class="plant-facts"><div><small>PLANT SPOTLIGHT</small><strong>Tropical hibiscus</strong></div><div><small>LIGHT</small><strong>Bright, sunny spot</strong></div><div><small>WATER</small><strong>Check soil; avoid waterlogging</strong></div><div><small>AVAILABILITY</small><strong>Confirm before ordering</strong></div></div><a class="button" href={enquiry('tropical hibiscus')}>Ask about hibiscus</a><p class="fine">Illustrative plant spotlight. Seasonal selection and stock await nursery confirmation.</p></div></div></section>
 <section id="why-us" class="section wrap" tabindex="-1"><div class="section-heading reveal"><div><p class="eyebrow">GROW WITH A LITTLE KNOW-HOW</p><h2>Good beginnings.<br /><em>Greener tomorrows.</em></h2></div><p>The right questions make plant shopping simpler. Here’s what to discuss before bringing your next plant home.</p></div><div class="values">{[['01','A plant that fits','Share your space, available light and experience level to shortlist suitable plants.'],['02','Know what you’re taking home','Ask about plant size, current condition and the pot or soil included.'],['03','Care that feels doable','Get plant-specific guidance on light, watering and drainage before you buy.'],['04','Plan the journey home','Confirm your PIN code, packing, pickup options and delivery charges.']].map(v=><article class="reveal"><span>{v[0]}</span><h3>{v[1]}</h3><p>{v[2]}</p></article>)}</div></section>
 <section id="delivery" class="delivery" tabindex="-1"><div class="wrap delivery-grid"><div class="reveal"><p class="eyebrow">FROM A GREEN CORNER TO YOURS</p><h2>Let’s see if we can<br /><em>reach your doorstep.</em></h2><p>Share your six-digit PIN code and the plants you’re interested in. Delivery availability, charges and timing must be confirmed before an order.</p><div class="delivery-notes"><span>Coverage confirmed individually</span><span>Pickup by prior arrangement only</span></div></div><form id="pin-form" class="pin-card" data-whatsapp={business.whatsapp}><label for="pin">Where would your plants call home?</label><p>Enter your West Bengal PIN code to prepare an enquiry.</p><div class="pin-input"><input id="pin" name="pin" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{6}" maxlength="6" required placeholder="Your 6-digit PIN code" aria-describedby="pin-help" /><button class="button" type="submit">Check my area</button></div><p id="pin-help" class="fine">This is an enquiry, not an automatic coverage guarantee.</p><p id="pin-result" role="status" tabindex="-1"></p><noscript><p>Please <a href="#contact">see contact information</a> to check delivery.</p></noscript></form></div></section>
 <section id="care" class="section wrap" tabindex="-1"><div class="section-heading reveal"><div><p class="eyebrow">LITTLE HABITS. HEALTHIER PLANTS.</p><h2>Grow your <em>confidence.</em></h2></div><a class="text-link" href={enquiry('plant-care guidance')}>Ask a plant-care question</a></div><div class="care-grid">{tips.map(t=><article class="care-card reveal"><span>{t[0]}</span><h3>{t[1]}</h3><p>{t[2]}</p></article>)}</div><p class="caption">General guidance; individual plants have different needs. <a href="https://www.rhs.org.uk/plants/types/houseplants/houseplant-101" target="_blank" rel="noopener noreferrer">Explore the RHS houseplant guide</a>.</p></section>
 <section id="contact" class="contact wrap" tabindex="-1"><p class="eyebrow">YOUR NEXT CHAPTER STARTS WITH A LEAF</p><h2>Let’s grow<br /><em>something lovely.</em></h2><p>Tell us about your space, its light, and your PIN code.<br />That’s a good place to start.</p>{business.whatsapp ? <a class="button" href={enquiry()}>Start a WhatsApp conversation</a> : <div class="preview-note"><strong>The nursery is getting ready to say hello.</strong><p>This website preview uses a working brand name. Verified WhatsApp, visiting hours and location will appear here before enquiries open.</p></div>}{business.phone && <a href={`tel:${business.phone}`}>{business.phone}</a>}{business.address && <p>{business.address}</p>}{business.hours && <p>{business.hours}</p>}{business.map && <a class="text-link" href={business.map} target="_blank" rel="noopener noreferrer">Get directions to the nursery</a>}</section>
 <section class="policies wrap" aria-label="Helpful details"><details><summary>Delivery & pickup</summary><p>Coverage, delivery charges, minimum order, timing and pickup arrangements are awaiting business confirmation. Please obtain these details before ordering.</p></details><details><summary>Plant availability & replacements</summary><p>Photographs are illustrative. Plant sizes, prices and availability must be confirmed. Replacement, damage-reporting and cancellation terms will be published when approved by the nursery.</p></details><details><summary>Privacy & photography</summary><p>This preview does not store enquiry details or PIN codes and uses no analytics or advertising cookies. Once configured, WhatsApp links will open WhatsApp with a draft message; you choose whether to send it. GitHub Pages, Google Fonts and Unsplash process normal connection data under their own policies.</p><p>Inspiration photography via <a href="https://unsplash.com/license" target="_blank" rel="noopener noreferrer">Unsplash</a>: Annie Spratt, Vadim Kaipov, Robert Thiemann, Artur Aldyrkhanov, id23 and Katarzyna Korobczuk. These images do not depict this nursery.</p></details></section>
 </main>
 <footer><div class="wrap footer-top"><a class="brand" href="#"><img src={`${base}favicon.svg`} width="42" height="42" alt="" /><span>Bengal Garden<small>N U R S E R Y</small></span></a><p>A little closer to nature.</p><a href="#plants">Explore plants</a><a href="#contact">Get in touch</a></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {business.name}</span><span>Rooted in Bengal. Growing with care.</span></div></footer>
 <a class="mobile-cta button" href={enquiry()}>Enquire on WhatsApp</a>
 <script>
 const menu = document.querySelector<HTMLButtonElement>('.menu');
 const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
 menu?.addEventListener('click', () => { const expanded = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded',String(!expanded)); menu.setAttribute('aria-label',expanded?'Open navigation':'Close navigation'); mobileNav!.hidden = expanded; });
 document.addEventListener('keydown',e=> { if(e.key==='Escape' && mobileNav && !mobileNav.hidden) { mobileNav.hidden=true; menu?.setAttribute('aria-expanded','false'); menu?.focus(); } });
 document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a=>a.addEventListener('click',()=>{if(mobileNav)mobileNav.hidden=true;menu?.setAttribute('aria-expanded','false'); const id=a.getAttribute('href')?.slice(1); if(id){const target=document.getElementById(id);target?.setAttribute('tabindex','-1');target?.focus({preventScroll:true});}}));
 const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
 if (!reduced.matches && 'IntersectionObserver' in window) { const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('seen');obs.unobserve(e.target);}}),{threshold:0.08});document.querySelectorAll('.reveal').forEach(el=>{el.classList.add('animate');obs.observe(el);}); }
 const form=document.querySelector<HTMLFormElement>('#pin-form');
 form?.addEventListener('submit',e=>{e.preventDefault();const pin=document.querySelector<HTMLInputElement>('#pin')!.value.trim();const result=document.querySelector<HTMLElement>('#pin-result')!;if(!/^[0-9]{6}$/.test(pin)){result.textContent='Please enter a six-digit PIN code.';result.focus();return;} const phone=form.dataset.whatsapp;if(phone){window.location.href=`https://wa.me/${phone}?text=${encodeURIComponent(`Hello, do you deliver to ${pin}? Please share current plant availability, delivery charges and timing.`)}`;}else{result.textContent=`Your PIN code is ${pin}. Delivery coverage is not yet confirmed. The nursery’s verified WhatsApp contact will be available when enquiries open. Your PIN code has not been sent or stored.`;result.focus();}});
 </script>
</body>
</html>
